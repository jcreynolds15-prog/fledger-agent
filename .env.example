# AP Automation Agent settings
#
# install.cmd writes agent.env for you by asking for these. To edit it later,
# open "C:\Program Files\AP Automation Agent\agent.env" in Notepad as
# administrator, then restart the agent:
#     Restart: Task Scheduler -> AP Automation Agent -> End, then Run
#     Check:   "C:\Program Files\AP Automation Agent\ap-automation-agent.exe" --test
#
# Put a value in 'single quotes' if it contains # or spaces.

# -- AP Automation -------------------------------------------------------------
# From AP Automation: Connectors -> Infor SyteLine -> Configure -> On-site agent
AGENT_KEY=

# Where the agent connects to. Only outbound HTTPS (port 443) is needed.
SERVER_URL=https://ap-automation.co.uk

# If this server reaches the internet through a proxy:
#   PROXY_URL=http://proxy.example.local:8080
#   PROXY_URL=http://user:password@proxy.example.local:8080
PROXY_URL=

# If the proxy inspects HTTPS with its own certificate and the agent cannot
# connect, export that root certificate as a .pem/.cer (Base-64) file:
#   TLS_CA_FILE=C:\Program Files\AP Automation Agent\proxy-root.pem
TLS_CA_FILE=

# -- SyteLine IDO web service (recommended) ------------------------------------
# SyteLine's own business rules and security apply to everything AP Automation
# does through it. The SyteLine user and password stay on this server.
#
# The service is on the SyteLine web (utility) server:
#   IDO_URL=http://slweb01/IDORequestService/IDOWebService.asmx
IDO_URL=
# The configuration to sign in to, as on the SyteLine sign-in screen
IDO_CONFIG=
# A SyteLine user for AP Automation. It must be licensed for the
# SyteLineAutomation module (Users form -> Modules).
IDO_USER=
IDO_PASSWORD=
# true accepts a self-signed certificate on an https:// IDO_URL
IDO_TLS_INSECURE=false

# -- Or: the SyteLine SQL database (reading only) -------------------------------
# Server name or IP. For a named instance: SQLSERVER\INSTANCE
MSSQL_SERVER=
# Leave blank for 1433, or for a named instance found by SQL Browser
MSSQL_PORT=
# The SyteLine application database (e.g. SL_APP), not the forms or objects database
MSSQL_DATABASE=
# A SQL Server login...
MSSQL_USER=
MSSQL_PASSWORD=
# ...or a Windows account: also set its domain (MSSQL_USER is then the Windows user name)
MSSQL_DOMAIN=
# SyteLine site (site_ref). Blank when the database holds one site.
MSSQL_SITE=
# Encrypt the SQL connection (needs SQL Server to have a certificate)
MSSQL_ENCRYPT=false
# Older SQL Servers (2012/2014 without their TLS 1.2 update) need this to sign in
MSSQL_LEGACY_TLS=false

# -- Posting ------------------------------------------------------------------
# true lets AP Automation create vouchers in SyteLine, through the IDO service
# only. Leave false until posting has been tried against a pilot or test
# configuration: AP Automation then only reads.
ALLOW_VOUCHERS=false

# Log detail: debug | info | warn | error. Logs are in the logs folder here.
LOG_LEVEL=info
