# ── Fledger SaaS connection ─────────────────────────────────────────────────
# Agent key shown on the Fledger connector settings page
AGENT_KEY=your-agent-key-here

# Base URL of the Fledger server (socket.io path /agent is added automatically)
# Production:  https://api.fledger.co.uk
# Local dev:   http://localhost:3000   (or your ngrok/localtunnel URL)
SERVER_URL=https://api.fledger.co.uk

# ── SQL Server credentials (stay on-premise — never sent to cloud) ────────
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=SyteLine
MSSQL_USER=sa
MSSQL_PASSWORD=your-sql-password

# Optional: set to your SyteLine site code (e.g. MAIN) for multi-site setups
# Leave blank if your database only has one site
MSSQL_SITE=

# Use Windows Authentication instead of SQL login (set MSSQL_USER/PASSWORD to blank)
# MSSQL_WINDOWS_AUTH=true

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info
